# Copie para backend/.env e preencha localmente. Não envie este arquivo preenchido.
# Use o MESMO banco e a MESMA chave do backend principal.
DATABASE_URL=
JWT_SECRET_KEY=
# IDs numéricos reais, separados por vírgula. O perfil deve ser administrador.
CENTRAL_ADMIN_IDS=
# Preserve a política de MFA que já está em uso no backend principal.
MFA_OBRIGATORIO_ENFORCE=true
ENVIRONMENT=development
TRUST_PROXY=false
ALLOWED_HOSTS=localhost,127.0.0.1
DOCS_HABILITADO=false
EMAIL_HABILITADO=false

