# Copie este arquivo para .env e ajuste os valores localmente.
# NUNCA commitar o arquivo .env real (ele ja esta no .gitignore).

# String de conexao com o PostgreSQL
DATABASE_URL=postgresql+psycopg2://eletrogestor:eletrogestor@localhost:5432/eletrogestor

# Chave usada para assinar os tokens JWT (gere uma chave forte em producao)
# Ex.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origens permitidas no CORS (separadas por virgula)
# Origens permitidas no CORS (separadas por virgula). 8081 = onde o Codex
# roda o frontend hoje; em producao, troque pela URL real via variavel de
# ambiente (nunca hardcode no codigo).
CORS_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Publicacao / seguranca (v1.1)
# ---------------------------------------------------------------------------
# "production" faz a API RECUSAR subir com JWT fraco, banco local ou CORS com localhost.
ENVIRONMENT=development
# Neon: cole a string de conexao como vem (postgresql://...?sslmode=require) -- o driver e' ajustado sozinho.
# Atras de proxy (Render/Cloudflare): confiar nos cabecalhos X-Forwarded-* e redirecionar http -> https.
TRUST_PROXY=false
FORCE_HTTPS=false
# Hosts aceitos (separados por virgula). Vazio = qualquer.
ALLOWED_HOSTS=
# Esconde /docs, /redoc e /openapi.json
DOCS_HABILITADO=true
# 2FA obrigatorio para administrador, desenvolvedor, tester, gerencia-geral e administrativo
MFA_OBRIGATORIO_ENFORCE=false
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_JANELA_SEGUNDOS=60
LOG_LEVEL=INFO
LOG_JSON=false
SENTRY_DSN=

# ---------------------------------------------------------------------------
# E-mail das notificacoes (SMTP). Resend: host smtp.resend.com, porta 587,
# usuario "resend", senha = API key (dominio de envio verificado no Resend).
# ---------------------------------------------------------------------------
EMAIL_HABILITADO=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_USAR_TLS=true
SMTP_USAR_SSL=false
EMAIL_REMETENTE=EletroGestor <nao-responder@eletrogestor.local>
EMAIL_MAX_TENTATIVAS=3
FRONTEND_URL=http://localhost:8081
